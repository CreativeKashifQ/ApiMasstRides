	// 	"prefix": "log",
	// 	"body": [
	// 		"console.log('$1');",
	// 		"$2"
	// 	],
	// 	"description": "Log output to console"
	// }
    "Form": {
        "scope": "blade",
        "prefix": "lw-form",
        "body": [
            "<form class=\"form-horizontal auth-form my-4\" wire:submit.prevent=\"$1\" wire:loading.attr=\"disabled\" wire:target=\"$1\">",
            "$2",
            "</form>"
        ]
    },
    "Input": {
        "scope": "blade",
        "prefix": "lw-input",
        "body": [
            "{{-- $3 --}}",
            "<div class=\"form-group\">",
            "<label>$1</label>",
            "<div class=\"input-group mb-3\">",
            "<input type=\"$2\" class=\"form-control @error('$3') is-invalid @enderror\" wire:model.defer='$3' placeholder=\"\">",
            "@error('$3')",
            "<span class=\"invalid-feedback\">{{ $$errors->first('$3') }}</span>",
            "@enderror",
            "</div>",
            "</div>",
        ]
    },
    "Select": {
        "scope": "blade",
        "prefix": "lw-select",
        "body": [
            "{{-- $2 --}}",
            "<div class=\"form-group\">",
            "<label>$1</label>",
            "<div class=\"input-group mb-3\">",
            "<select class=\"form-control @error('$2') is-invalid @enderror\" wire:model.defer='$2'>",
            "<option value=null disabled selected>-- $3 --</option>",
            "</select>",
            "@error('$2')",
            "<span class=\"invalid-feedback\">{{ $$errors->first('$2') }}</span>",
            "@enderror",
            "</div>",
            "</div>",
        ]
    },
    "Submit": {
        "scope": "blade",
        "prefix": "lw-submit",
        "body": [
            "{{-- $1 --}}",
            "<button type=\"submit\" class=\"btn btn-primary waves-effect waves-light\">",
            "<span class=\"spinner-border spinner-border-sm mr-1\" wire:loading.delay wire:target='$1'></span> $2",
            "</button>"
        ]
    },
    "Switch": {
        "scope": "blade",
        "prefix": "lw-switch",
        "body": [
            "{{-- $1 --}}",
            "<div class=\"form-group\">",
            "<div class=\"custom-control custom-switch switch-success\">",
            "@php $$switchId = uniqid() @endphp",
            "<input type=\"checkbox\" class=\"custom-control-input\" id=\"customRadio{{ $$switchId }}\" wire:model.lazy='$1'>",
            "<label class=\"custom-control-label text-muted\" for=\"customRadio{{ $$switchId }}\">",
            "$2",
            "</label>",
            "</div> @error('$1')",
            "<span class=\"text-danger small\">{{ $$errors->first('$1') }}</span>",
            "@enderror",
            "</div>"
        ],
    },
    "Livewire Compoent Setup": {
        "scope": "php",
        "prefix": "lw-component-setup",
        "body": [
            "/*",
            "|--------------------------------------------------------------------------",
            "| Public Data",
            "|--------------------------------------------------------------------------",
            "| This data will be visible to client. Don't instantiate any instance of a class",
            "| containing sensitive information",
            "*/",
            "",
            "",
            "/*",
            "|--------------------------------------------------------------------------",
            "| Override Properties",
            "|--------------------------------------------------------------------------",
            "| Component properties like rules, messages",
            "*/",
            "",
            "",
            "/*",
            "|--------------------------------------------------------------------------",
            "| Listeners",
            "|--------------------------------------------------------------------------",
            "| Livewire event listeners like created, updated or deleted",
            "*/",
            "",
            "",
            "/*",
            "|--------------------------------------------------------------------------",
            "| Lifecycle Hooks",
            "|--------------------------------------------------------------------------",
            "| Component hooks like hydrate, updated, render",
            "*/",
            "",
            "",
            "/*",
            "|--------------------------------------------------------------------------",
            "| Methods",
            "|--------------------------------------------------------------------------",
            "| User defined methods like, register, verify or load",
            "*/",
            "",
            "",
            "/*",
            "|--------------------------------------------------------------------------",
            "| Helper Functions",
            "|--------------------------------------------------------------------------",
            "| Class helper functions",
            "*/",
        ]
    },
    "List Group": {
        "scope": "blade",
        "prefix": "lw-list-group",
        "body": [
            "<div class=\"list-group\">",
            "<div class=\"list-group-item h5 m-0\">",
            "<div class=\"d-flex justify-content-between\">",
            "<div>$title</div>",
            "<div>",
            "<a href=\"javascript:void(0)\" class=\"small text-primary\" wire:click='$toggleEditable'>$Update</a>",
            "</div>",
            "</div>",
            "</div>",
            "$end",
            "</div>"
        ]
    },
    "List Group Item": {
        "scope": "blade",
        "prefix": "lw--list-group-item",
        "body": [
            "<div class=\"list-group-item py-2 pt-4\">",
            "<div class=\"row\">",
            "<div class=\"col font-weight-semibold\">$Property</div>",
            "<div class=\"col-9\">{{ $value }}</div>",
            "</div>",
            "</div>"
        ]
    },
    "Page Header": {
        "scope": "blade",
        "prefix": "lw-page-header",
        "body": [
            "<div class=\"row\">",
            "<div class=\"col-lg-6 offset-lg-3\">",
            "{{-- page title --}}",
            "<div class=\"page-title-box text-center py-5\">",
            "<h4 class=\"page-title\">$title</h4>",
            "<p class=\"text-muted\">$description</p>",
            "<hr>",
            "</div>",
            "</div>",
            "</div>"
        ]
    },
    "Button": {
        "scope": "blade",
        "prefix": "lw-button",
        "body": [
            "{{-- $action --}}",
            "<button type=\"button\" wire:click='$action' wire:loading.attr='disabled' class=\"btn btn-primary waves-effect waves-light\">",
            " <span class=\"spinner-border spinner-border-sm mr-1\" wire:loading.delay wire:target='$action'></span> $Button",
            "</button>",
        ]
    },
    "Input Horizontal": {
        "scope": "blade",
        "prefix": "lw-input-horizontal",
        "body": [
            "{{-- $2 --}}",
            "<div class=\"form-group mb-2\">",
            "<div class=\"row\">",
            "<label  class=\"col-sm-3 col-form-label text-left\">$1</label>",
            "<div class=\"col-sm-9\">",
            "<input class=\"form-control @error('$2') is-invalid @enderror\" type=\"text\" wire:model.defer='$2'>",
            "@error('$2')",
            "<span class=\"invalid-feedback\">{{ $errors->first('$2') }}</span>",
            "@enderror",
            "</div>",
            "</div>",
            "</div>",
        ]
    },
    "Select Horizontal": {
        "scope": "blade",
        "prefix": "lw-select-horizontal",
        "body": [
            "{{-- $2 --}}",
            "<div class=\"form-group mb-2\">",
            "<div class=\"row\">",
            "<label class=\"col-sm-3 col-form-label text-left\">$1</label>",
            "<div class=\"col-sm-9\">",
            "<select class=\"form-control @error('$2') is-invalid @enderror\" wire:model='$2'>",
            "<option value=null disabled selected>-- Select $1 --</option>",
            "@foreach ($$items as $$item)",
            "{{--<option {{ $$item == $$value ? 'selected' : '' }}>{{ $$item }}</option>--}}",
            "@endforeach",
            "</select>",
            "@error('$2')",
            "<span class=\"invalid-feedback\">{{ $errors->first('$2') }}</span>",
            "@enderror",
            "</div>",
            "</div>",
            "</div>",
        ]
    }
}
